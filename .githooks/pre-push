#!/bin/sh
# pre-push —— push 之前先在本機把檢查跑完，紅的就不讓它上去
#
# ## 為什麼是 hook 不是 GitHub Actions
# private repo 的 Actions 要付費額度，而這個 repo 的檢查只要 3 秒、零依賴。
# CI 對一個人用的專案，真正的價值是「不靠你記得」—— hook 一樣做得到。
#
# ## 裝法（換機器 clone 之後要跑一次，hook 不會跟著 clone 過來）
#   git config core.hooksPath .githooks
#
# ## 真的要跳過（例如只改 README 又很趕）
#   git push --no-verify
#   ⚠️ 但這個 repo 被「兩份東西漂移而且沒有訊號」咬過很多次，跳過前想一下。

set -e

echo "── pre-push 檢查 ──────────────────────────────"

log="$(mktemp)"
trap 'rm -f "$log"' EXIT

# ── 版本號守衛 ────────────────────────────────────────────────────────
# 改了 plugins/ 卻沒 bump 版本號 ⇒ 使用者跑 `claude plugin update` 會拿到
# 「already at the latest version」—— 語氣是成功的，所以沒有人會去查，
# 而 cache 停在舊 commit。2026-09-01 踩過兩次，第二次是在把規則寫進
# HANDOFF §0 之後三個 commit 內自己違反的。散文守不住東西。
printf '  版本號（動了 plugins/ 就必須 bump）… '
base="$(git rev-parse --verify --quiet origin/main || true)"
if [ -z "$base" ]; then
  echo "跳過（沒有 origin/main 可比對）"
else
  changed_plugin="$(git diff --name-only "$base"..HEAD -- plugins/ | grep -v '/tests/' || true)"
  version_now="$(node -p "require('./plugins/spec-pipeline/.claude-plugin/plugin.json').version")"
  version_base="$(git show "$base":plugins/spec-pipeline/.claude-plugin/plugin.json 2>/dev/null \
    | node -p "JSON.parse(require('fs').readFileSync(0,'utf8')).version" 2>/dev/null || echo '')"
  if [ -n "$changed_plugin" ] && [ "$version_now" = "$version_base" ]; then
    echo "紅"
    echo
    echo "  plugins/ 有改動，但版本號還是 $version_now ——"
    echo "  使用者的 \`claude plugin update\` 會回報「已是最新版」而實際上什麼都沒拉。"
    echo
    echo "  改動的檔案："
    echo "$changed_plugin" | sed 's/^/    /'
    echo
    echo "  ⇒ 同時 bump 這兩處（validate-plugin 會檢查兩邊一致）："
    echo "      plugins/spec-pipeline/.claude-plugin/plugin.json  version"
    echo "      .claude-plugin/marketplace.json                   plugins[].version"
    echo
    echo "⇒ push 中止。"
    exit 1
  fi
  echo "OK（$version_base → $version_now）"
fi

printf '  形狀檢查（manifest / frontmatter / 引用 / schema）… '
if node scripts/validate-plugin.mjs > "$log" 2>&1; then
  echo "OK"
else
  echo "紅"
  echo
  cat "$log"
  echo
  echo "⇒ push 中止。修好再推，或 git push --no-verify 強推。"
  exit 1
fi

printf '  測試… '
if node --test plugins/spec-pipeline/tests/*.test.mjs > "$log" 2>&1; then
  echo "$(grep -E '^# pass' "$log" | tr -dc 0-9) 個全過"
else
  echo "紅"
  echo
  # 只印失敗的部分，不要把整份 TAP 倒出來
  grep -E '^not ok|^# (tests|pass|fail)|error:|AssertionError' "$log" | head -40
  echo
  echo "完整輸出： node --test plugins/spec-pipeline/tests/*.test.mjs"
  echo "⇒ push 中止。"
  exit 1
fi

echo "───────────────────────────────────────────────"
