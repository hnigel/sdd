    87	/** S3 還有未收口的 BLOCKER 就不該凍結 —— 「S3 不 GREEN 不進 Step 4」。 */
    88	function assertS3Clear() {
    89	  if (!fs.existsSync(REVIEW_STATE)) {
    90	    console.error('⚠️ 沒有 .claude/review-state.json —— 無法確認 S3 收口了沒。凍結照做，但這件事沒有被驗過。');
    91	    return;
    92	  }
    93	  const st = JSON.parse(fs.readFileSync(REVIEW_STATE, 'utf8')).stages?.S3;
    94	  if (!st || !st.rounds.length) {
    95	    console.error('⚠️ review-state 裡 S3 還沒有任何有效的一輪 —— 凍結照做，但 S3 尚未真的通過。');
    96	    return;
    97	  }
    98	  const open = (st.rounds[st.rounds.length - 1].blockers ?? []).filter((b) => !b.resolved);
    99	  if (open.length) {
   100	    console.error(`spec-freeze: S3 還有 ${open.length} 條未收口（${open.map((b) => b.id).join(', ')}）⇒ 不得凍結。`);
   101	    console.error('「S3 不 GREEN 不進 Step 4」—— 先把它們收掉。');
   102	    process.exit(20);
   103	  }
   104	}
   105	
   106	function freeze(spec) {
   107	  if (!spec || !fs.existsSync(spec)) usage(`--freeze 需要存在的規格檔（找不到 ${spec}）`);
   108	  assertS3Clear();
   109	  const content = fs.readFileSync(spec, 'utf8');
   110	  save({
   111	    version: 1,
   112	    spec: path.relative(ROOT, path.resolve(spec)),
   113	    sha: sha(content),
   114	    frozen_at: new Date().toISOString(),
   115	    content,
