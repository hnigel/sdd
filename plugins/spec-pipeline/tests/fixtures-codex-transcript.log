    71	    return '';
    72	  } catch (e) {
    73	    if (e.status === 1) {
    74	      // git 的 `a/` `b/` 前綴後面直接接絕對路徑（斜線是路徑自己的），
    75	      // 所以替換時要保留前導斜線，否則會變成 `adesign.md`
    76	      const esc = (x) => x.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
